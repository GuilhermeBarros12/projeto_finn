# Copie para .env.production. Esse arquivo real nunca deve ir para o git.
POSTGRES_USER=finn
# Pode usar qualquer caractere: a API monta a URL de conexão com a codificação certa.
# Num $ literal, escreva $, por causa do Docker Compose.
POSTGRES_PASSWORD=troque-por-uma-senha-forte
POSTGRES_DB=finn_db

# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=gere-uma-chave-aleatoria-com-pelo-menos-32-caracteres

# Endereço público exato, com https
FRONTEND_ORIGIN=https://finn.seudominio.com.br
WEB_PORT=8080

# Use false somente para testar em http://localhost, nunca em produção
COOKIE_SECURE=true
# 1 = só o nginx do Finn; 2 = nginx do Finn + um proxy HTTPS à frente
TRUST_PROXY=2

# Assistente: sem a chave, só o chat fica indisponível
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
AGENT_RATE_LIMIT_MAX=30

# E-mail de "esqueci a senha" (Resend). Sem a chave, nenhum e-mail sai e o link não chega.
RESEND_API_KEY=
EMAIL_FROM=Finn <nao-responda@seudominio.com.br>

# Login com o Google: opcional; o botão só aparece com as duas variáveis
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Dias de sessão
SESSION_DAYS=30

# Só estes e-mails podem criar conta (separados por vírgula). Vazio = cadastro aberto.
SIGNUP_ALLOWED_EMAILS=
