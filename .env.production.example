# Copie para .env.production. Esse arquivo real nunca deve ir para o git.
POSTGRES_USER=finn
# Evite @ : / nesta senha, pois ela entra na URL de conexão
POSTGRES_PASSWORD=troque-por-uma-senha-forte
POSTGRES_DB=finn_db

# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=gere-uma-chave-aleatoria-com-pelo-menos-32-caracteres

# Endereço público exato, com https
FRONTEND_ORIGIN=https://finn.seudominio.com.br
WEB_PORT=8080

# Use false somente para testar em http://localhost, nunca em produção
COOKIE_SECURE=true
# 1 = só o nginx do Finn; 2 = nginx do Finn + um proxy HTTPS à frente
TRUST_PROXY=2
