# Banco de dados da aplicação
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/finn_db?schema=public"

# Em vez de DATABASE_URL, também dá para usar POSTGRES_HOST, POSTGRES_USER, POSTGRES_PASSWORD e POSTGRES_DB.

# Banco usado pelos testes. É apagado a cada teste: precisa ser local, ter "test" no nome
# e ser diferente de DATABASE_URL. Para um servidor descartável, TEST_DATABASE_ALLOW_REMOTE=true.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/finn_test?schema=public"

# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="gere-uma-chave-aleatoria-com-pelo-menos-32-caracteres"

# Sessão: token de acesso curto, renovado por um cookie HttpOnly de longa duração
ACCESS_TOKEN_EXPIRES_IN="15m"
REFRESH_TOKEN_DAYS=30

FRONTEND_ORIGIN="http://localhost:5173"

# Assistente: sem a chave, o resto do app funciona e só o chat fica indisponível.
# Crie a chave em https://platform.claude.com/ e nunca a envie para o git.
ANTHROPIC_API_KEY=""

# Opcionais
# ANTHROPIC_MODEL=claude-opus-5-5
# Perguntas por pessoa, por hora
# AGENT_RATE_LIMIT_MAX=30
# PORT=3333
# APP_TIMEZONE=America/Sao_Paulo
# LOG_LEVEL=info
# LOGIN_RATE_LIMIT_MAX=10
# Só estes e-mails podem criar conta (separados por vírgula). Vazio = cadastro aberto.
# SIGNUP_ALLOWED_EMAILS=voce@exemplo.com
# Quantos proxies reversos existem na frente da API (necessário para o limite por IP)
# TRUST_PROXY=0
# Por padrão o cookie só é Secure quando NODE_ENV=production
# COOKIE_SECURE=true
