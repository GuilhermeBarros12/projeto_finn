// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CategoryType {
  INCOME
  EXPENSE
}

enum PaymentMethod {
  PIX
  CREDIT_CARD
  DEBIT_CARD
  CASH
  BANK_TRANSFER
  OTHER
}

enum GoalType {
  SAVINGS
  SPENDING_LIMIT
}

enum GoalStatus {
  IN_PROGRESS
  COMPLETED
  EXPIRED
}

model User {
  id            String         @id @default(uuid(7))
  name          String
  email         String         @unique
  password      String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  preference    Json?
  categories    Category[]
  transactions  Transaction[]
  goals         Goal[]
  refreshTokens RefreshToken[]
  cards         Card[]
  recurrences   Recurrence[]
}

model RefreshToken {
  id        String    @id @default(uuid(7))
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId  String
  tokenHash String    @unique
  expiresAt DateTime
  rotatedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
}

model Category {
  id           String        @id @default(uuid(7))
  userId       String?
  user         User?         @relation(fields: [userId], references: [id])
  code         String
  name         String
  type         CategoryType
  icon         String
  color        String
  status       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  transactions Transaction[]
  goals        Goal[]

  @@unique([userId, code])
  @@index([userId, status])
}

model Transaction {
  id                 String        @id @default(uuid(7))
  userId             String
  categoryId         String
  user               User          @relation(fields: [userId], references: [id])
  category           Category      @relation(fields: [categoryId], references: [id])
  type               CategoryType
  description        String
  date               DateTime
  paymentMethod      PaymentMethod
  value              Decimal       @db.Decimal(15, 2)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  cardId             String?
  card               Card?         @relation(fields: [cardId], references: [id])
  installmentGroupId String?
  installmentNumber  Int?
  installmentCount   Int?
  recurrenceId       String?
  recurrence         Recurrence?   @relation(fields: [recurrenceId], references: [id])

  @@index([userId, date])
  @@index([userId, categoryId])
  @@index([userId, paymentMethod])
  @@index([cardId, date])
  @@index([installmentGroupId])
  @@index([recurrenceId, date])
}

model Card {
  id               String        @id @default(uuid(7))
  userId           String
  user             User          @relation(fields: [userId], references: [id])
  name             String
  closingDay       Int
  dueDay           Int
  isDefault        Boolean       @default(false)
  status           Boolean       @default(true)
  datesConfirmedAt DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  transactions     Transaction[]

  @@index([userId, status])
}

model Recurrence {
  id           String        @id @default(uuid(7))
  userId       String
  user         User          @relation(fields: [userId], references: [id])
  endDate      DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  transactions Transaction[]

  @@index([userId])
}

model Goal {
  id          String     @id @default(uuid(7))
  userId      String
  categoryId  String?
  user        User       @relation(fields: [userId], references: [id])
  category    Category?  @relation(fields: [categoryId], references: [id])
  title       String
  type        GoalType
  targetValue Decimal    @db.Decimal(15, 2)
  dueDate     DateTime
  status      GoalStatus @default(IN_PROGRESS)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([userId, status])
  @@index([userId, categoryId])
}
